  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.3.0",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.1.0",
    "vitest": "^3.2.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "@playwright/test": "^1.56.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "@types/node": "^22.10.0"
  }
}
